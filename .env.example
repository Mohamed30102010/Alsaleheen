# --- Database (PostgreSQL: Neon / Vercel Postgres / Supabase) ---
DATABASE_URL=

# --- Auth ---
# random string, 32+ chars  (e.g. run: openssl rand -base64 32)
AUTH_SECRET=
# first admin account (created automatically on first build if it doesn't exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
